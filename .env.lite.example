# Conservative defaults for low-compute laptops/VPS hosts.
# Copy to .env (or pass directly with --env-file) and set required secrets.
POSTGRES_DB=your_postgres_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql+psycopg://your_postgres_user:replace_with_strong_password@postgres:5432/your_postgres_db
REDIS_URL=redis://redis:6379/0
BACKEND_API_BASE_URL=http://backend:8000
SEC_USER_AGENT=FundamentalTerminal/1.0 (contact@example.com)
MARKET_USER_AGENT=FundamentalTerminal/1.0 (contact@example.com)
APP_PROFILE=lite
UVICORN_WORKERS=1
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
REFRESH_QUEUE_POLL_SECONDS=10
DATA_FETCHER_STARTUP_DELAY_SECONDS=180
DATA_FETCHER_HEALTH_START_PERIOD=210s
DATA_FETCHER_RUN_MACRO_WORKER=false
DATA_FETCHER_ENQUEUE_ON_STARTUP=false
WORKER_IDENTIFIERS=AAPL,MSFT
SP500_PREWARM_LIMIT=0
OBSERVABILITY_MAX_RECORDS=500
PERFORMANCE_AUDIT_ENABLED=false
HOT_RESPONSE_CACHE_ENABLED=true
STRICT_OFFICIAL_MODE=true
